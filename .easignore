# Keep EAS uploads focused on source and required build assets.

# dependencies
node_modules/

# Expo outputs and caches
.expo/
.expo-validation/
.expo-*-validation/
dist/
dist-android/
dist-video-check/
dist-release-check/
web-build/
expo-env.d.ts

# generated native folders
/ios
/android
.kotlin/

# credentials that must never be uploaded from the workspace
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro and package-manager logs
.metro-health-check*
metro-*.log
metro.err.log
metro.out.log
npm-debug.*
yarn-debug.*
yarn-error.*

# local operating-system and editor files
.DS_Store
.claude/

# local development and device-test artifacts
/artifacts/
tmp-*.png
tmp-*.xml
store-assets/android/raw/

# local environment files
.env*.local

# TypeScript caches
*.tsbuildinfo

# examples are not part of the application build
/example
